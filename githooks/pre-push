#!/usr/bin/env bash
set -euo pipefail

if [[ "${RUN_SCREENSHOT_PRE_PUSH:-0}" != "1" ]]; then
  echo "Skipping local screenshot generation. GitHub Actions regenerates screenshot artifacts on push." >&2
  echo "Set RUN_SCREENSHOT_PRE_PUSH=1 to run npm run screenshots:update before pushing." >&2
  exit 0
fi

npm run screenshots:update

if ! git diff --quiet -- docs/screenshots README.md; then
  echo "Screenshots or README changed during pre-push." >&2
  echo "Review and commit the generated files, then push again." >&2
  git status --short -- docs/screenshots README.md >&2
  exit 1
fi
