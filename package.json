{
  "name": "search-options-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "api:dev": "node --import tsx apps/api/src/main.ts",
    "dev": "npm run web:build && npm run api:dev",
    "web:build": "vite build",
    "web:dev": "vite --host 127.0.0.1",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "screenshots:update": "node --import tsx scripts/capture-screenshots.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "search:backfill": "node --import tsx scripts/backfill-search.ts",
    "search:sync-worker": "node --import tsx scripts/search-sync-worker.ts",
    "search:reset": "node --import tsx scripts/reset-search-indexes.ts",
    "verify:full-stack": "node --import tsx scripts/verify-full-stack.ts",
    "stack:full": "npm run web:build && docker compose -f compose/docker-compose.full.yml up --build",
    "stack:full:detached": "npm run web:build && docker compose -f compose/docker-compose.full.yml up -d --build",
    "stack:full:down": "docker compose -f compose/docker-compose.full.yml down",
    "verify:embeddings": "node --import tsx scripts/verify-embeddings.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@meilisearch/instant-meilisearch": "^0.31.1",
    "@tanstack/virtual-core": "^3.17.0",
    "instantsearch.js": "^4.101.1",
    "leaflet": "^1.9.4",
    "pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typesense-instantsearch-adapter": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "vite": "^8.0.16"
  }
}
